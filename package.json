{
  "name": "proyecto-dwssr-2026-b",
  "version": "1.0.0",
  "description": "Sistema web para monitoreo y detección de anomalías en un motor (proyecto final de Desarrollo Web SSR)",
  "main": "server/bin/www.js",
  "scripts": {
    "start": "NODE_ENV=production node ./server/bin/www.js",
    "dev": "nodemon ./server/bin/www.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:front": "vite",
    "build": "vite build",
    "preview": "npm run build && npm start",
    "lint:back": "eslint \"server/**/*.js\"",
    "lint:front": "eslint \"src/**/*.{js,mjs}\"",
    "lint:all": "npm run lint:back && npm run lint:front",
    "dev:vite": "vite --host",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:vite\"",
    "clean:logs": "rm -rf ./logs/*.log"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Josse66/PROYECTO-DWSSR-2026-B.git"
  },
  "keywords": [],
  "author": "José Armando Cid González",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Josse66/PROYECTO-DWSSR-2026-B/issues"
  },
  "homepage": "https://github.com/Josse66/PROYECTO-DWSSR-2026-B#readme",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.6",
    "http-errors": "^2.0.1",
    "mongoose": "^9.12.3",
    "morgan": "~1.9.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "imports": {
    "#server/*": "./server/*",
    "#routes/*": "./server/routes/*"
  }
}
